// SMR / theta-beta operant training at Cz — BrainBit Flex variant.
//
// Same math as `smr_cz.refrain` but adapted for amplifiers that:
//   - Have a dedicated hardware reference (not a user-placed software
//     reference). `referential(reference: "device")` uses the channel
//     as-recorded.
//   - Are AC-coupled (BrainBit doesn't expose DC).
//   - Run at 250 Hz (BrainBit's only sample rate).
//
// Electrode placement: scalp channel #1 at Cz; the other three may be
// placed at sites your protocol library wants (frontal / parietal) or
// left as artifact / ground references. SMR Cz only needs the Cz channel.
//
// Strawman example for Refrain v0.0r1.

protocol "smr_cz_brainbit_v1" {

  meta {
    version           = "1.0.0"
    evidence          = "demo"
    description       = "SMR/theta-beta operant training at Cz, BrainBit Flex monopolar"
    author            = "Peak Mind"
    citation          = "Sterman M.B. & Lubar J.F. (foundational corpus, 1970s-1990s)"
    population        = "children_adults"
    indication        = "ADHD_attention_regulation"
    control_ref       = "library/operant/smr_sham@1.0"
    safety_monitoring = ["pre_session_check", "intra_session_clinician_observation"]
    outcome_measures  = ["IVA-2_continuous_performance", "Conners-3"]
  }

  requires {
    coupling    = "ac"
    sample_rate = ">= 250 Hz"
    channels    = ["Cz"]
    impedance   = "not_required"
    markers     = "not_required"
  }

  // Monopolar Cz — uses the BrainBit's dedicated hardware reference.
  input "raw" {
    montage = referential(active: "Cz", reference: "device")
  }

  derive "smr_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (12 Hz, 15 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  derive "theta_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (4 Hz, 8 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  derive "high_beta_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (22 Hz, 30 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  // Adaptive thresholds — the target_pct fields are wired to the
  // controls below so clinicians can adjust them mid-session.
  threshold "smr_t" {
    signal       = "smr_envelope"
    type         = percentile(target_pct: smr_target_pct, window: 2 min)
    live_tunable = true
  }

  threshold "theta_t" {
    signal       = "theta_envelope"
    type         = percentile(target_pct: theta_target_pct, window: 2 min)
    live_tunable = true
  }

  threshold "hbeta_t" {
    signal = "high_beta_envelope"
    type   = absolute(8 uV)
  }

  reward {
    event = dwell(
      condition: all_of([
        above("smr_envelope",       "smr_t"),
        below("theta_envelope",     "theta_t"),
        below("high_beta_envelope", "hbeta_t"),
      ]),
      duration: 250 ms
    )
    continuous = sigmoid("smr_envelope" / "smr_t",
                         midpoint: 1.0, steepness: 3)
  }

  output {
    audio_chime = reward.event
    audio_gain  = reward.event.holds ? reward.continuous : 0
  }

  controls {
    smr_target_pct = percent {
      default      = 70
      range        = (50, 90)
      label        = "SMR target percentile"
      live_tunable = true
    }
    theta_target_pct = percent {
      default      = 30
      range        = (10, 50)
      label        = "Theta target percentile"
      live_tunable = true
    }
  }

  session {
    phases = [
      phase { name = "warmup";   duration = 90 s;  output_muted = true },
      phase { name = "training"; duration = 30 min },
      phase { name = "cooldown"; duration = 30 s;  output_muted = true },
    ]
  }
}
