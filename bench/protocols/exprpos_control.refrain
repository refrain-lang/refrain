// Regression fixture for prereq A (baseline-seeding plan, Task 1): a
// `control_ref` in a PLAIN VALUE POSITION (`gain * "env"`), not one of the
// recognised tunable-parameter slots (`percentile(target_pct: ...)`,
// `smooth(tau: ...)`, `sigmoid(midpoint: ...)`, `absolute(value: ...)`).
// Before the fix, the Rust core's `build_node` baked `Expr::ControlRef` to a
// frozen `CNode::Const(default)` here, so `set_control("gain", ...)` was a
// silent no-op in the Rust evaluator (Python evaluates every control_ref live
// via `_control_deps`, regardless of slot). `set_control.rs`'s
// `expression_position_control_ref_is_live` test drives this fixture with a
// single "Cz" channel and asserts the output retunes after `set_control`.
//
// Uses `reference: "device"` (as-recorded, no software re-referencing) rather
// than `linked_ears`: the test evaluator is instantiated with only the "Cz"
// channel, and `linked_ears` falls back to common-average-of-all-present-
// channels when no ear channels exist, which with a single channel means
// self-subtraction (active - mean(active) == 0) — it would zero the signal
// before `magnitude()` ever sees it, regardless of `gain`. `device` is the
// same precedent used by `micro_10_autocorr.refrain` / `micro_06_coherence.refrain`
// for a single-channel Cz source.
protocol "exprpos_control" {
  meta { version = "1.0.0"; evidence = "demo"; description = "expr-position control ref" }
  requires { sample_rate = ">= 256 Hz"; channels = ["Cz"] }
  input "raw" { montage = referential(active: "Cz", reference: "device") }
  derive "env" { from = "raw"; pipeline = [ magnitude() ] }
  reward { continuous = gain * "env" }
  output { x = reward.continuous }
  controls {
    gain = frequency { default = 1.0 Hz; range = (0.5 Hz, 5 Hz); live_tunable = true }
  }
}
